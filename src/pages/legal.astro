---
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/500.css';
import '@fontsource/ibm-plex-mono/500.css';

const title = 'Aviso legal — The Atlantic Community';
const description =
	'The Atlantic Community está inscrita en el Registro Central de Asociaciones de la Xunta de Galicia con el número 2026/28557-1 y NIF G88909411.';
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImageURL = new URL('/og-image-1.png', Astro.site);
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#050505" />
		<meta name="robots" content="index, follow" />
		<link rel="canonical" href={canonicalURL} />

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="The Atlantic Community" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:image" content={socialImageURL} />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={socialImageURL} />

		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
		<link rel="manifest" href="/site.webmanifest">
		<title>{title}</title>
	</head>
	<body>
		<main>
			<header>
				<a class="wordmark" href="/" aria-label="The Atlantic Community — inicio">
					<span>The Atlantic</span><span>Community</span>
				</a>
				<p class="tagline">Aviso legal</p>
			</header>

			<section>
				<p>
					The Atlantic Community está inscrita en el Registro Central de Asociaciones de la
					Xunta de Galicia con el número 2026/28557-1 y NIF G88909411.
				</p>
			</section>
		</main>
	</body>
</html>

<style>
	:global(*) {
		box-sizing: border-box;
	}

	:global(html) {
		background: #050505;
		color-scheme: dark;
	}

	:global(body) {
		margin: 0;
		background: #050505;
		color: #f4f4f2;
		font-family: 'IBM Plex Sans', sans-serif;
		-webkit-font-smoothing: antialiased;
	}

	main {
		display: flex;
		min-height: 100svh;
		flex-direction: column;
		justify-content: space-between;
		padding: clamp(1.5rem, 4vw, 3.75rem);
	}

	header {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 2rem;
	}

	.wordmark {
		margin: 0;
		font-family: 'IBM Plex Mono', monospace;
		font-size: clamp(1.45rem, 2.4vw, 2.2rem);
		font-weight: 500;
		letter-spacing: -0.04em;
		line-height: 0.98;
		text-decoration: none;
	}

	.wordmark span {
		display: block;
	}

	.tagline {
		max-width: 19rem;
		margin: 0;
		color: #a5a5a0;
		font-size: 0.76rem;
		line-height: 1.45;
		text-align: right;
	}

	section {
		max-width: 32rem;
		padding-top: 8rem;
	}

	section p {
		margin: 0;
		font-size: clamp(1.15rem, 1.8vw, 1.55rem);
		letter-spacing: -0.03em;
		line-height: 1.3;
	}

	a {
		color: inherit;
		transition: color 160ms ease;
	}

	a:hover,
	a:focus-visible {
		color: #a5a5a0;
	}

	a:focus-visible {
		outline: 1px solid currentColor;
		outline-offset: 0.35rem;
	}

	@media (max-width: 720px) {
		header {
			flex-direction: column;
		}

		.tagline {
			text-align: left;
		}

		section {
			padding-top: 6rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		a {
			transition: none;
		}
	}
</style>
